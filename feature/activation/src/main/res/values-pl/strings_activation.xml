<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Dodawanie playlisty</string>
    <string name="mac_label">ADRES MAC</string>
    <string name="key_label">KLUCZ URZĄDZENIA</string>
    <string name="copy_mac">Kopiuj adres MAC</string>
    <string name="copy_key">Kopiuj klucz urządzenia</string>
    <string name="copied_mac">Skopiowano adres MAC</string>
    <string name="copied_key">Skopiowano klucz urządzenia</string>
    <string name="add_playlist">Dodaj playlistę</string>
    <string name="refresh">Odśwież</string>
    <string name="refresh_checking">Sprawdzanie…</string>
    <string name="refresh_found">Znaleziono subskrypcję</string>
    <string name="refresh_none">Możesz teraz dodać swoją pierwszą playlistę.</string>
