<?xml version="1.0" encoding="utf-8"?>
<!--
  The player, in English.

  Nothing user-visible in this feature is written in Kotlin, for the reason the activation
  feature states: a literal in a composable is a string that never gets translated and that
  nobody finds when they go looking.

  The three failure messages are the ones worth reading twice. They differ because what the
  user can do about them differs, and the buttons differ with them — offering "try the other
  player" where it cannot possibly help is worse than offering nothing at all.
-->
<resources>

    <!-- The bars -->
    <string name="player_back">Back</string>
    <string name="player_lock">Lock the screen</string>
    <string name="player_unlock">Unlock the screen</string>
    <string name="player_cast">Play on a device</string>
    <string name="player_more">More</string>
    <string name="player_close">Close</string>
    <string name="player_play">Play</string>
    <string name="player_pause">Pause</string>
    <string name="player_previous">Previous</string>
    <string name="player_next">Next</string>
    <string name="player_replay_10">Back ten seconds</string>
    <string name="player_forward_10">Forward ten seconds</string>
    <string name="player_fullscreen">Fill the screen</string>
    <string name="player_channels">Channels</string>
    <string name="player_guide">Guide</string>

    <!-- Live -->
    <string name="player_live">LIVE</string>
    <string name="player_live_now">Live now</string>
    <string name="player_to_live">Back to live</string>
    <!-- %1$s is a duration, already formatted: "4:12". -->
    <string name="player_behind_live">%1$s behind live</string>
    <string name="player_catchup">Catch-up</string>

    <!-- Opening, and what happens while it is late -->
    <string name="player_opening">Opening…</string>
    <string name="player_buffering">Buffering…</string>
    <string name="player_reconnecting">Connection lost — retrying</string>
    <!-- %1$d of %2$d -->
    <string name="player_attempt">Attempt %1$d of %2$d</string>
    <string name="player_switching">The main player could not open this — switching to the backup</string>
    <string name="player_engine_backup">Player 2</string>

    <!-- The three failures -->
    <string name="player_error_title">This would not play</string>
    <string name="player_error_detail">The main player does not support this encoding. The backup player can try it.</string>
    <string name="player_error_retry">Try again</string>
    <string name="player_error_backup">Use the backup player</string>
    <string name="player_unsupported_title">Format not supported</string>
    <string name="player_unsupported_detail">Neither player can read this encoding. Try another source.</string>
    <string name="player_drm_title">Protected content</string>
    <string name="player_drm_detail">This source needs a form of protection this device does not support.</string>
    <string name="player_network_title">Could not reach this source</string>
    <string name="player_network_detail">Nothing answered at that address. Check your connection.</string>
    <string name="player_not_found_title">Nothing at that address</string>
    <string name="player_not_found_detail">The link led nowhere. Your provider can tell you whether it moved.</string>

    <string name="player_source_title">This file could not be opened</string>
    <string name="player_source_detail">Castivio could not read it. It may have moved, or the app may no longer have access to it.</string>
    <string name="player_timeout_title">Nothing arrived</string>
    <string name="player_timeout_detail">The source did not send a picture and reported no error. Trying again is worth a go.</string>
    <string name="player_decoder_title">This would not play</string>
    <string name="player_decoder_detail">A decoder on this device refused it. The backup player tries a different one.</string>
    <string name="player_copy_report">Copy report</string>

    <!-- Locked -->
    <string name="player_locked">Screen locked — press and hold to unlock</string>

    <!-- The sheets -->
    <string name="player_sheet_subtitles">Subtitles</string>
    <string name="player_sheet_audio">Audio track</string>
    <string name="player_sheet_settings">Settings</string>
    <string name="player_sheet_quality">Video quality</string>
    <string name="player_subtitles_off">No subtitles</string>
    <string name="player_speed">Playback speed</string>
    <string name="player_aspect">Aspect ratio</string>
    <string name="player_aspect_fit">Fit</string>
    <string name="player_aspect_fill">Fill</string>
    <string name="player_aspect_16_9">16:9</string>
    <string name="player_aspect_4_3">4:3</string>
    <string name="player_aspect_zoom">Zoom</string>
    <string name="player_quality_auto">Automatic</string>
    <string name="player_pip">Picture in picture</string>
    <string name="player_statistics">Playback statistics</string>
    <!-- Shown when the container has declared none. Not an error: many streams carry one track. -->
    <string name="player_no_tracks">This stream carries only one.</string>

    <!-- The statistics panel, which is only ever built when it is opened -->
    <string name="stat_resolution">Resolution</string>
    <string name="stat_frame_rate">Frame rate</string>
    <string name="stat_codec">Codec</string>
