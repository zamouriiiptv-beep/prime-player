<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Two cleartext attributes, because they cover different versions.
        `networkSecurityConfig` exists from API 24 and is where the reasoning lives;
        `usesCleartextTraffic` is what API 23 reads. Below 23 the platform permits
        cleartext anyway. See `res/xml/network_security_config.xml` for why an IPTV
        player has to allow it at all.
    -->
    <application
        android:name=".CastivioApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:banner="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CastivioTV">

        <!--
            `locale|layoutDirection` in configChanges is the pair that stops the
            flicker.

            Changing the language used to tear the window down twice: once
            because the app called `recreate()`, and once more on API 33+ because
            `LocaleManager.applicationLocales` makes the platform do it as well.
            Two teardowns, two flashes of the window background through the
            aurora, and every screen rebuilt from nothing.

            Neither is needed. `attachBaseContext` already forces Castivio's
            locale onto the context the activity is built on, so a locale
            configuration change carries no information the app does not already
            have. It is delivered to `onConfigurationChanged` instead, and the
            composition re-reads its strings in place.

            `smallestScreenSize|density|uiMode|keyboard|navigation` are changes a
            television box can make on its own: an HDMI mode negotiated again when
            the set wakes, a remote reconnecting, the box switching its mode. Each
            one rebuilt the activity, and a rebuilt activity opens the shell on Home
            with no player in it while the player's view model, which belongs to
            the activity and is kept across the rebuild, went on decoding: sound,
            no picture, and the channel's tile where the video had been. Castivio
            has one theme and a composition that re-reads its configuration, so
            all five are taken in place like the rest.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
