<?xml version="1.0" encoding="utf-8"?>
<!--
  The index-cost lab: a second launcher entry that exists in debug builds and nowhere else.

  It lives in `src/debug/`, so it is merged into the debug variant's manifest only; the release and
  benchmark builds neither contain the activity nor declare it. It is a separate activity on purpose:
  the product's own screens, its Hilt graph and its database are not involved in any way. See
  `DbLabActivity` for what it does and, as important, what it never touches.

  `exported` is required by the launcher intent filter (targetSdk 34). `configChanges` is the product
  activity's own list, so a rotation or a keyboard change never rebuilds the screen under a run that
  takes minutes.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.castivio.tv.debug.lab.DbLabActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Castivio DB Lab"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
