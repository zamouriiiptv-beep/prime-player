<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Reading the device's own media.

        Split by version because the platform split it: before Android 13 one broad
        storage permission covered everything, and from 13 the media types are separate,
        which is both better for the user and two different requests. `maxSdkVersion` on
        the old one so a modern device is never asked for a permission it would refuse.

        Deliberately *not* here: WRITE_EXTERNAL_STORAGE and MANAGE_EXTERNAL_STORAGE.
        Castivio reads media and never writes it, and the all-files permission is the one
        that gets an application removed from the store.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".CastivioApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:banner="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.CastivioTV">

        <!--
            `locale|layoutDirection` in configChanges is the pair that stops the
            flicker.

            Changing the language used to tear the window down twice: once
            because the app called `recreate()`, and once more on API 33+ because
            `LocaleManager.applicationLocales` makes the platform do it as well.
            Two teardowns, two flashes of the window background through the
            aurora, and every screen rebuilt from nothing.

            Neither is needed. `attachBaseContext` already forces Castivio's
            locale onto the context the activity is built on, so a locale
            configuration change carries no information the app does not already
            have. It is delivered to `onConfigurationChanged` instead, and the
            composition re-reads its strings in place.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
