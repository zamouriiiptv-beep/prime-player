<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Voeg je abonnement toe</string>
    <string name="trial_name">Castivio-proefperiode</string>
    <string name="mac_label">MAC-ADRES</string>
    <string name="key_label">APPARAATSLEUTEL</string>
    <string name="copy_mac">MAC-adres kopiëren</string>
    <string name="copy_key">Apparaatsleutel kopiëren</string>
    <string name="copied_mac">MAC-adres gekopieerd</string>
    <string name="copied_key">Apparaatsleutel gekopieerd</string>
    <string name="add_playlist">Playlist toevoegen</string>
    <string name="refresh">Vernieuwen</string>
    <string name="refresh_checking">Controleren…</string>
    <string name="refresh_found">Abonnement gevonden</string>
    <string name="refresh_none">Nog geen abonnement</string>
    <string name="refresh_error">Vernieuwen mislukt — probeer opnieuw</string>
    <string name="qr_caption">Scan om in te stellen op je telefoon</string>
    <string name="legal_player_only">Castivio is alleen een speler en levert geen abonnementen of content.</string>
    <string name="mac_spoken">MAC-adres %s</string>
    <string name="language">Taal</string>
    <string name="language_count">%d beschikbaar</string>
    <string name="language_close">Sluiten</string>
    <string name="language_back_hint">Terug om te sluiten</string>
    <string name="language_selected">Geselecteerd</string>
    <string name="activation_screen">Voeg je abonnement toe</string>

    <plurals name="trial_days">
