    <!--
      Why a fetch failed, one sentence per cause.

      Deliberately eight different messages and not one. A timeout, a refused
      subscription and a server having a bad afternoon lead to three different actions,
      and a single "we could not reach your provider" sends most people to check a
      password that was never the problem.
    -->
    <string name="fail_network_title">No connection to your provider</string>
    <string name="fail_network_detail">The address could not be reached at all. Check this device is online, then try again.</string>
    <string name="fail_timeout_title">Your provider is not answering</string>
    <string name="fail_timeout_detail">It took too long to reply. That is usually the server being busy rather than anything wrong here.</string>
    <string name="fail_rejected_title">Your provider refused the request</string>
    <string name="fail_rejected_detail">The subscription was rejected. Check it with your provider — nothing on this device will change that.</string>
    <string name="fail_not_found_title">Nothing at that address</string>
    <string name="fail_not_found_detail">Your provider answered but has no such section. Check the server address in Settings.</string>
    <string name="fail_unreadable_title">Your provider sent something unreadable</string>
    <string name="fail_unreadable_detail">The reply was not in a format this app understands. That is a problem at their end.</string>
    <string name="fail_server_title">Your provider had a problem</string>
    <string name="fail_server_detail">Their server reported an error of its own. It usually clears on its own.</string>
    <string name="fail_no_provider_title">No provider yet</string>
    <string name="fail_no_provider_detail">Add a subscription before browsing.</string>
    <string name="fail_unknown_title">That did not work</string>
    <string name="fail_unknown_detail">Something went wrong fetching this section. The rest of the app is unaffected.</string>

