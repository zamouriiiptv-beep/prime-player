<?xml version="1.0" encoding="utf-8"?>
<!--
  `:app` owns the launcher label and nothing else.

  It used to own forty strings, all of them Arabic, left over from the
  pre-modular prototype. Thirty-nine were dead. The fortieth was `qr_caption`,
  and it was a live bug: resource merging lets an application module override a
  library module's value for the same name and qualifier, so this file's Arabic
  string replaced `feature:activation`'s English one in the **default** bucket.
  `values-ar` and `values-ko` were served by the feature module and were right,
  so the screen was correct in every language except English, which is exactly
  what the real-device review found.

  The rule that stops it happening again is mechanical: `check-invariants.sh`
  fails the build if a string declared here is also declared by a feature or
  core module. A user-visible string belongs to the module that draws it.

  The activation address is not here either. A URL is configuration, not copy:
  it lives in `ActivationDestination` so that the QR and the on-screen button
  cannot drift apart, and so replacing the placeholder is one edit.
-->
<resources>
    <string name="app_name">Castivio</string>
</resources>
