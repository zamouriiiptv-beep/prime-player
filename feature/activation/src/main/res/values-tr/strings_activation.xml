<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Aboneliğinizi ekleyin</string>
    <string name="trial_name">Castivio deneme sürümü</string>
    <string name="mac_label">MAC ADRESİ</string>
    <string name="key_label">CİHAZ ANAHTARI</string>
    <string name="copy_mac">MAC adresini kopyala</string>
    <string name="copy_key">Cihaz anahtarını kopyala</string>
    <string name="copied_mac">MAC adresi kopyalandı</string>
    <string name="copied_key">Cihaz anahtarı kopyalandı</string>
    <string name="add_playlist">Oynatma listesi ekle</string>
