<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Shtoni abonimin tuaj</string>
    <string name="trial_name">Provë e Castivio</string>
    <string name="mac_label">ADRESA MAC</string>
    <string name="key_label">ÇELËSI I PAJISJES</string>
    <string name="copy_mac">Kopjo adresën MAC</string>
    <string name="copy_key">Kopjo çelësin e pajisjes</string>
    <string name="copied_mac">Adresa MAC u kopjua</string>
    <string name="copied_key">Çelësi i pajisjes u kopjua</string>
    <string name="add_playlist">Shto listë luajtjeje</string>
    <string name="refresh">Rifresko</string>
    <string name="refresh_checking">Po kontrollohet…</string>
    <string name="refresh_found">U gjet abonim</string>
    <string name="refresh_none">Ende asnjë abonim</string>
    <string name="refresh_error">Rifreskimi dështoi — provoni sërish</string>
    <string name="qr_caption">Skanoni për ta konfiguruar në telefon</string>
    <string name="legal_player_only">Castivio është vetëm një luajtës dhe nuk ofron abonime apo përmbajtje.</string>
    <string name="mac_spoken">Adresa MAC %s</string>
    <string name="language">Gjuha</string>
    <string name="language_count">%d të disponueshme</string>
