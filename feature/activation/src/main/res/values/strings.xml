<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation flow, in English.

  Default locale, so this file is what ships when a device asks for a language nobody
  has translated yet. values-ar/ carries the Arabic.

  Nothing user-visible in this feature is written in Kotlin. A literal in a composable
  is a string that never gets translated and that nobody finds when they go looking.
-->
<resources>

    <!-- Activation, the first screen -->

    <!-- The MAC address: the route that matters most -->

    <!-- The honest state of the portal. Not a placeholder: this is what is true today. -->

    <!-- Add manually -->
    <string name="source_choice_title">What did your provider give you?</string>
    <string name="source_xtream_title">Xtream Codes</string>
    <string name="source_xtream_detail">A server address, a username and a password.</string>
    <string name="source_m3u_title">M3U playlist</string>
    <string name="source_m3u_detail">Add a playlist link in M3U format.</string>
    <string name="source_local_title">Play a video from this device</string>
    <string name="source_local_detail">Play a video file stored on this device.</string>
    <string name="source_users_title">Saved users</string>
    <!-- Short on purpose: the four cards share one height, so a description that
         wraps in one of them makes all four taller. This one is the longest of the
         four and the first to wrap. -->
    <string name="source_users_detail">Add or switch between Xtream and M3U.</string>
    <string name="source_terms">Terms of Service</string>
    <!-- Follows `source_terms` on the same line, and it is one line: the footer
         shares Back's row, so a wrap would push the sentence out of it. -->
    <string name="source_terms_note"> — By using this app, you agree to the Terms of Service.</string>

    <!-- The device's own media: browse everything, or pick one file. Nothing here
         names MediaStore or the document picker — those are how the four will be
         built, not what the user is choosing between. -->
    <string name="media_source_title">What would you like to play?</string>
    <string name="media_video_library_title">Video library</string>
    <string name="media_video_library_detail">Every video on this device.</string>
    <string name="media_video_pick_title">Choose a video</string>
    <string name="media_video_pick_detail">Pick a video file from this device.</string>
    <string name="media_audio_library_title">Audio library</string>
    <!-- The longest of the four, and so the first to wrap: the cards share one
         height, so a wrap in this one makes all four taller. -->
    <string name="media_audio_library_detail">Every audio file on this device.</string>
    <string name="media_mp3_pick_title">Choose an MP3</string>
    <string name="media_mp3_pick_detail">Pick an MP3 file from this device.</string>

    <!-- What the four cards open. Nothing here names an API: "video files only" is
         what the user is being shown, "video/*" is how it will be asked for. -->
    <string name="media_video_library_empty">No videos on this device yet.</string>
    <string name="media_audio_library_empty">No audio files on this device yet.</string>
    <string name="media_picker_filter_video">Video files only</string>
    <string name="media_picker_filter_audio">MP3 files only</string>
    <string name="media_picker_empty">This folder is empty.</string>
    <string name="media_picker_parent">Parent folder</string>
    <string name="media_permission_denied">Castivio needs permission to read the media on this device.</string>
    <string name="media_reading">Reading this device…</string>
    <string name="media_picker_root">Internal storage</string>

    <!-- The subscriptions already on this box.

         The screen manages what is saved here; it is not where connection details are
         read or changed. That is why no row carries a username, a password or a server
         URL: a name, a kind and a date are what tell two subscriptions apart, and they
         are the only things anybody needs to see to choose between them. -->
    <string name="saved_sources_title">My subscriptions</string>
    <string name="saved_sources_subtitle">Manage every subscription saved on this device</string>
    <string name="saved_sources_empty">No subscriptions saved on this device yet.</string>
    <string name="saved_sources_add_xtream">Add Xtream</string>
    <string name="saved_sources_add_m3u">Add M3U</string>
    <string name="saved_sources_active">Active now</string>
    <!-- Only for rows written before a name was decided at registration. Every
         subscription registered since has one, so this is legacy data's fallback and
         not a state the product can still produce. -->
    <string name="saved_sources_unnamed">Unnamed playlist</string>
    <!-- "Added on 20/09/2026". The date is formatted by the platform for the reader's
         locale, so the format is not written here. -->
    <string name="saved_sources_added">Added on %1$s</string>

    <!-- Renaming, which is the whole of "edit" on this screen. The second line is the
         point of it: this changes what the subscription is called and nothing else, and
         a user who pressed a pencil expecting the server form should find that out
         before they start typing rather than after they save. -->
    <string name="saved_sources_edit">Edit</string>
    <string name="saved_sources_rename_title">Playlist name</string>
    <string name="saved_sources_rename_detail">The name you see in your list of subscriptions. It does not change the connection details.</string>
    <!-- The field's own label, and deliberately not the dialog's title again. The two
         were the same string, so the words "Playlist name" were drawn twice, one under
         the other, with a sentence between them saying what they meant. The heading
         names the dialog; this names the box. -->
    <string name="saved_sources_rename_field">Name</string>
    <string name="saved_sources_rename_save">Save</string>

    <!-- Deleting. Two warnings, because they are two different facts.

         Any subscription may be deleted, the active one included, and nothing is
         activated in its place — which subscription the app shows is the user's choice
         to make, and making it for them at the moment they deleted another is the one
         thing this screen must not do. So the second message says what will actually
         happen rather than refusing the press. -->
    <string name="saved_sources_delete">Delete</string>
    <string name="saved_sources_delete_title">Delete this subscription?</string>
    <string name="saved_sources_delete_detail">It will be removed from this device only.</string>
    <string name="saved_sources_delete_active_title">This is the subscription in use</string>
    <string name="saved_sources_delete_active_detail">Deleting it will stop it being used on this device. Do you want to continue?</string>
    <string name="saved_sources_cancel">Cancel</string>

    <!-- The forms -->
    <string name="field_playlist_name">Playlist name</string>
    <string name="field_optional">Optional</string>
    <string name="field_playlist_name_placeholder">Home</string>
    <string name="field_server_url">Server URL</string>
    <string name="field_server_url_placeholder">http://example.com:8080</string>
    <string name="field_username">Username</string>
    <string name="field_password">Password</string>
    <string name="field_playlist_url">M3U playlist URL</string>
    <string name="field_playlist_url_placeholder">http://example.com/get.php?…</string>
    <string name="action_connect">Connect</string>
    <string name="action_back">Back</string>

    <!-- What is wrong with a field -->
    <string name="problem_required">This one is needed.</string>
    <string name="problem_too_long">That is longer than it should be.</string>
    <string name="problem_contains_spaces">There is a space in there. A link cannot contain one.</string>
    <string name="problem_unsupported_scheme">Castivio can only open http and https links.</string>
    <string name="problem_incomplete_host">That does not look like a complete address.</string>
    <string name="problem_invalid_port">That port number is not valid.</string>

    <!-- The Xtream link hiding in a playlist URL -->
    <string name="detected_xtream_title">This looks like an Xtream link</string>
    <string name="detected_xtream_detail">Read as Xtream it also brings categories, series and your subscription status. It works either way.</string>
    <string name="detected_xtream_accept">Use Xtream instead</string>

    <!-- Importing -->
    <string name="importing_checking">Checking your details…</string>
    <string name="importing_reading">Reading your playlist</string>
    <string name="importing_items">%1$s items found</string>
    <string name="importing_groups">%1$d groups ready</string>
    <string name="importing_cancel">Cancel</string>
    <string name="importing_takes_a_while">A large playlist can take a minute. You can leave this running.</string>

    <!-- Done -->
    <string name="activation_done_title">Ready</string>
    <string name="activation_done_detail">%1$s items are on this device.</string>
    <string name="activation_done_action">Start watching</string>

    <!-- Failures -->
    <string name="failure_unreachable_title">Could not reach your provider</string>
    <string name="failure_unreachable_detail">Nothing answered at that address. Check your connection and the server address.</string>
    <string name="failure_timed_out_title">Your provider took too long</string>
    <string name="failure_timed_out_detail">The server answered too slowly to finish. It is often busy rather than broken.</string>
    <string name="failure_rejected_title">Those details were refused</string>
    <string name="failure_rejected_detail">Your provider did not accept this username and password. Check them exactly as they were sent to you.</string>
    <string name="failure_subscription_ended_title">This subscription has ended</string>
    <string name="failure_subscription_ended_detail">Your provider says it expired. Renewing it is something they do, not something Castivio can do for you.</string>
    <string name="failure_provider_refused_title">Your provider refused this line</string>
    <string name="failure_provider_refused_detail">It answered, and said no. Your provider can tell you why.</string>
    <string name="failure_not_found_title">Nothing at that address</string>
    <string name="failure_not_found_detail">The link led nowhere. It is almost always a typo — check it once more.</string>
    <string name="failure_unreadable_title">That is not a playlist</string>
    <string name="failure_unreadable_detail">Something answered, but Castivio could not read it as a playlist.</string>
    <string name="failure_provider_error_title">Your provider had a problem</string>
    <string name="failure_provider_error_detail">Their server reported a fault. Trying again shortly usually works.</string>
    <string name="failure_empty_title">Your provider sent nothing</string>
    <string name="failure_empty_detail">The playlist opened and contained no channels. Your provider can tell you whether the line is ready.</string>
    <string name="failure_unsupported_title">Not supported in this build</string>
    <string name="failure_unsupported_detail">Castivio cannot activate that kind of source yet.</string>
    <string name="failure_unknown_title">That did not work</string>
    <string name="failure_unknown_detail">Something went wrong that Castivio could not name. Trying again is worth a go.</string>
    <string name="failure_stopped_after">Stopped after %1$s items.</string>
    <string name="failure_retry">Try again</string>
    <string name="failure_edit">Edit details</string>

    <!-- The licence gate, which has no screen of its own yet -->
    <string name="licence_blocked_title">Castivio is not licensed on this device</string>
    <string name="licence_blocked_detail">This build has no licence service to ask, so it cannot let you in. The licence screen arrives in a later version.</string>
    <string name="licence_blocked_action">Close</string>
    <!-- The source chooser, redrawn as a grid. -->
    <string name="source_badge_fastest">Fastest</string>
    <!-- The second line of each card: what the first one does not say, which is
         how a reader tells which of these they actually have. -->
    <string name="source_xtream_hint">Full support for Xtream features.</string>
    <string name="source_m3u_hint">One long link, usually sent by e-mail.</string>
    <string name="source_local_hint">All common formats supported.</string>
    <string name="source_users_hint">Easy management of all your subscriptions.</string>
    <string name="media_video_library_subtitle">Browse and play every video saved on your device</string>
    <string name="media_audio_library_subtitle">Browse every audio file on your device</string>
    <!-- The two folder choosers: the top of each picker's tree. -->
    <string name="media_video_folder_title">Choose a video folder</string>
    <string name="media_video_folder_subtitle">Choose the folder whose videos you want to browse</string>
    <string name="media_audio_folder_title">Choose an audio folder</string>
    <string name="media_audio_folder_subtitle">Choose the folder whose audio files you want to browse</string>
    <plurals name="media_folder_videos">
        <item quantity="one">%1$d video</item>
        <item quantity="other">%1$d videos</item>
    </plurals>
    <plurals name="media_folder_tracks">
        <item quantity="one">%1$d audio file</item>
        <item quantity="other">%1$d audio files</item>
    </plurals>
    <!-- The theme control in every header. Named by what pressing it does. -->
    <string name="action_theme_lighter">Switch to the lighter theme</string>
    <string name="action_theme_darker">Switch to the darker theme</string>
    <string name="source_choice_subtitle">Choose how you want to add your content source</string>
    <!-- The local-media chooser: the line under its name, and its own footnote. -->
    <string name="media_source_subtitle">Choose how you want to play your content</string>
    <string name="media_trust_sources_title">Multiple sources</string>
    <string name="media_trust_sync_title">Automatic sync</string>
    <string name="media_trust_organised_title">Organised content</string>
    <!-- The assurance strip under the four choices. -->
    <string name="source_trust_private_title">Safe and private</string>
    <string name="source_trust_fast_title">Fast and steady</string>
</resources>
