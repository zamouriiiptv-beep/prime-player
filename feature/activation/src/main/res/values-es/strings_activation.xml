<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Añadir una lista de reproducción</string>
    <string name="mac_label">DIRECCIÓN MAC</string>
    <string name="key_label">CLAVE DEL DISPOSITIVO</string>
    <string name="copy_mac">Copiar la dirección MAC</string>
    <string name="copy_key">Copiar la clave del dispositivo</string>
    <string name="copied_mac">Dirección MAC copiada</string>
    <string name="copied_key">Clave del dispositivo copiada</string>
    <string name="add_playlist">Añadir lista</string>
    <string name="refresh">Actualizar</string>
    <string name="refresh_checking">Comprobando…</string>
    <string name="refresh_found">Suscripción encontrada</string>
    <string name="refresh_none">Ya puedes añadir tu primera lista de reproducción.</string>
    <string name="refresh_error">No se pudo actualizar — inténtalo de nuevo</string>
    <string name="qr_caption">Escanea el código QR para activar este dispositivo.</string>
    <string name="legal_player_only">Castivio es solo un reproductor y no proporciona suscripciones ni contenidos.</string>
    <string name="mac_spoken">Dirección MAC %s</string>
    <string name="language">Idioma</string>
    <string name="language_count">%d disponibles</string>
    <string name="language_close">Cerrar</string>
    <string name="language_back_hint">Atrás para cerrar</string>
    <string name="language_selected">Seleccionado</string>
    <string name="activation_screen">Añadir una lista de reproducción</string>

    <plurals name="trial_badge">
        <item quantity="one">Prueba de %d día</item>
        <item quantity="other">Prueba de %d días</item>
    </plurals>

    <string name="locale_sentinel" translatable="false">es</string>
</resources>
