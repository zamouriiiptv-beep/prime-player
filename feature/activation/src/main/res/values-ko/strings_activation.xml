<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">구독 추가</string>
    <string name="trial_name">Castivio 체험판</string>
    <string name="mac_label">MAC 주소</string>
    <string name="key_label">기기 키</string>
    <string name="copy_mac">MAC 주소 복사</string>
    <string name="copy_key">기기 키 복사</string>
    <string name="copied_mac">MAC 주소를 복사했습니다</string>
    <string name="copied_key">기기 키를 복사했습니다</string>
    <string name="add_playlist">재생목록 추가</string>
    <string name="refresh">새로고침</string>
    <string name="refresh_checking">확인 중…</string>
    <string name="refresh_found">구독을 찾았습니다</string>
    <string name="refresh_none">아직 구독이 없습니다</string>
