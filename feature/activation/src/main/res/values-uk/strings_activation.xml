<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Додавання плейлиста</string>
    <string name="mac_label">MAC-АДРЕСА</string>
    <string name="key_label">КЛЮЧ ПРИСТРОЮ</string>
    <string name="copy_mac">Копіювати MAC-адресу</string>
    <string name="copy_key">Копіювати ключ пристрою</string>
    <string name="copied_mac">MAC-адресу скопійовано</string>
    <string name="copied_key">Ключ пристрою скопійовано</string>
    <string name="add_playlist">Додати плейлист</string>
    <string name="refresh">Оновити</string>
    <string name="refresh_checking">Перевірка…</string>
    <string name="refresh_found">Підписку знайдено</string>
    <string name="refresh_none">Тепер можна додати перший плейлист.</string>
    <string name="refresh_error">Не вдалося оновити — спробуйте ще раз</string>
    <string name="qr_caption">Відскануйте QR-код, щоб активувати цей пристрій.</string>
    <string name="legal_player_only">Castivio — лише програвач; він не надає підписок або контенту.</string>
    <string name="mac_spoken">MAC-адреса %s</string>
