<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Legg til abonnementet ditt</string>
    <string name="trial_name">Castivio-prøveperiode</string>
    <string name="mac_label">MAC-ADRESSE</string>
    <string name="key_label">ENHETSNØKKEL</string>
    <string name="copy_mac">Kopier MAC-adressen</string>
    <string name="copy_key">Kopier enhetsnøkkelen</string>
    <string name="copied_mac">MAC-adressen er kopiert</string>
    <string name="copied_key">Enhetsnøkkelen er kopiert</string>
    <string name="add_playlist">Legg til spilleliste</string>
    <string name="refresh">Oppdater</string>
    <string name="refresh_checking">Sjekker…</string>
    <string name="refresh_found">Abonnement funnet</string>
    <string name="refresh_none">Nå kan du legge til den første spillelisten din.</string>
    <string name="refresh_error">Kunne ikke oppdatere — prøv igjen</string>
    <string name="qr_caption">Skann QR-koden for å åpne aktiveringssiden for enheten</string>
    <string name="legal_player_only">Castivio er bare en spiller og tilbyr ikke abonnementer eller innhold.</string>
    <string name="mac_spoken">MAC-adresse %s</string>
    <string name="language">Språk</string>
