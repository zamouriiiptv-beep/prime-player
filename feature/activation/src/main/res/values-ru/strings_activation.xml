<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Добавление плейлиста</string>
    <string name="mac_label">MAC-АДРЕС</string>
    <string name="key_label">КЛЮЧ УСТРОЙСТВА</string>
    <string name="copy_mac">Копировать MAC-адрес</string>
    <string name="copy_key">Копировать ключ устройства</string>
    <string name="copied_mac">MAC-адрес скопирован</string>
    <string name="copied_key">Ключ устройства скопирован</string>
    <string name="add_playlist">Добавить плейлист</string>
    <string name="refresh">Обновить</string>
    <string name="refresh_checking">Проверка…</string>
    <string name="refresh_found">Подписка найдена</string>
    <string name="refresh_none">Теперь можно добавить первый плейлист.</string>
    <string name="refresh_error">Не удалось обновить — попробуйте снова</string>
    <string name="qr_caption">Отсканируйте QR-код, чтобы активировать это устройство.</string>
