<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Tilføj dit abonnement</string>
    <string name="trial_name">Castivio-prøveperiode</string>
    <string name="mac_label">MAC-ADRESSE</string>
    <string name="key_label">ENHEDSNØGLE</string>
    <string name="copy_mac">Kopiér MAC-adressen</string>
    <string name="copy_key">Kopiér enhedsnøglen</string>
    <string name="copied_mac">MAC-adressen er kopieret</string>
    <string name="copied_key">Enhedsnøglen er kopieret</string>
    <string name="add_playlist">Tilføj playliste</string>
    <string name="refresh">Opdatér</string>
    <string name="refresh_checking">Kontrollerer…</string>
    <string name="refresh_found">Abonnement fundet</string>
    <string name="refresh_none">Endnu intet abonnement</string>
    <string name="refresh_error">Kunne ikke opdatere — prøv igen</string>
    <string name="qr_caption">Scan QR-koden for at åbne enhedens aktiveringsside</string>
    <string name="legal_player_only">Castivio er kun en afspiller og leverer ikke abonnementer eller indhold.</string>
    <string name="mac_spoken">MAC-adresse %s</string>
    <string name="language">Sprog</string>
    <string name="language_count">%d tilgængelige</string>
    <string name="language_close">Luk</string>
    <string name="language_back_hint">Tilbage for at lukke</string>
    <string name="language_selected">Valgt</string>
    <string name="activation_screen">Tilføj dit abonnement</string>

    <plurals name="trial_days">
        <item quantity="one">%d dag</item>
        <item quantity="other">%d dage</item>
    </plurals>

    <string name="locale_sentinel" translatable="false">da</string>
</resources>
