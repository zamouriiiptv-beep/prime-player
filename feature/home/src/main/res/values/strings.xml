<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Section names, as they appear in the rail, the header and the empty states. -->
    <string name="browse_live">Live TV</string>
    <string name="browse_movies">Movies</string>
    <string name="browse_series">Series</string>
    <string name="browse_radio">Radio</string>

    <!-- The first entry in the category pane: the whole section, unfiltered. -->
    <string name="browse_all_categories">All</string>

    <string name="browse_episode_count">%1$d episodes</string>

    <!-- Used in place of a provider's name before one is known. -->
    <string name="browse_your_provider">your provider</string>

    <string name="browse_empty_category_title">This category is empty</string>
    <string name="browse_empty_category_detail">Your provider lists this category but has not put anything in it. Choose another category, or All to see everything.</string>

    <!-- %1$s is the provider's name, %2$s the section: "IPTV Pro carries no Radio". -->
    <string name="browse_empty_section_title">%1$s carries no %2$s</string>
    <string name="browse_empty_section_detail">Your other sections are unaffected. If this looks wrong, refresh — an import that is still running fills sections one at a time.</string>
    <string name="browse_empty_action">Refresh</string>

    <string name="show_season">Season %1$d</string>
    <string name="show_no_episodes_title">No episodes yet</string>
    <string name="show_no_episodes_detail">Your provider lists this show but has not sent its episodes. It usually appears after the next refresh.</string>
    <string name="show_back">Back</string>

    <string name="home_brand">CASTIVIO</string>
    <string name="home_empty_title">Nothing imported yet</string>
    <string name="home_empty_detail">Your provider was reached but sent no channels, films or series. Refresh from a section, or add another provider.</string>

    <string name="search_label">Search</string>
    <string name="search_placeholder">Channels, films, series</string>
    <string name="search_prompt">Results appear as you type — there is no button and no wait.</string>
    <string name="search_results">Results</string>
    <!-- %1$s is exactly what the user typed, echoed back. -->
    <string name="search_none_title">Nothing matched “%1$s”</string>
    <string name="search_none_detail">Try fewer letters, or part of the name instead of all of it.</string>
    <string name="search_clear">Clear</string>


    <!-- ============================================================ the dashboard -->
    <string name="home_tagline">Premium IPTV player</string>

    <!-- Shown before any provider is configured: the one screen that has to lead
         somewhere, because nothing else on Home can work until it does. -->
    <string name="home_no_source_title">No subscription yet</string>
    <string name="home_no_source_detail">Add your provider and Castivio imports its channels, films and series onto this device. Xtream Codes, an M3U link, or activation by MAC address.</string>
    <string name="home_add_source">Add a subscription</string>
    <string name="home_change_source">Add or change subscription</string>
    <string name="home_settings">Settings</string>

    <!-- %1$s is an already-grouped number: "1,661 channels". -->
    <string name="home_count_live">%1$s channels</string>
    <string name="home_count_movies">%1$s films</string>
    <string name="home_count_series">%1$s series</string>
    <string name="home_count_radio">%1$s stations</string>

    <!-- Which kind of provider is showing, for a user who has several saved. -->
    <string name="home_source_m3u">M3U</string>
    <string name="home_source_file">File</string>
    <string name="home_source_xtream">Xtream</string>
    <string name="home_source_portal">Portal</string>

    <string name="home_disclaimer">Castivio is a media player. It does not provide channels, films or subscriptions — you add your own.</string>


    <!-- The order a section is read in. %1$s is one of the four below. -->
    <string name="browse_sort">Sort: %1$s</string>
    <string name="browse_sort_provider">Provider</string>
    <string name="browse_sort_name_asc">A to Z</string>
    <string name="browse_sort_name_desc">Z to A</string>
    <string name="browse_sort_recent">Recent</string>


    <!-- A section being brought onto the device the first time it is opened.
         %1$s is the section name. Shown on the loading gate, which is the whole
         screen a section is fetched on; see LoadingGate.kt. -->
    <string name="browse_fetch_title">Loading %1$s…</string>
    <string name="browse_fetch_once">This runs once. Next time this section opens straight away.</string>
    <string name="browse_fetch_failed">Could not load %1$s</string>
    <string name="browse_fetch_failed_retryable">Your provider did not answer in time. It is usually busy rather than down.</string>
    <string name="browse_fetch_failed_final">Your provider refused the request. Check the subscription, or add it again from Home.</string>
    <string name="browse_fetch_retry">Try again</string>


    <!-- ================================================== the loading gate
         The screen a section is fetched on, before the section itself. Every
         figure on it comes from a real counter; see LoadingGate.kt. -->
    <string name="gate_wordmark">Castivio</string>
    <!-- %1$s is the installed APK's own version name, read from the platform. -->
    <string name="gate_version">Version %1$s</string>
    <!-- %1$s categories finished of %2$s, and %3$s received so far, already
         formatted, e.g. “7.2 MB”. Categories rather than channels because the
         channel total is not known until the last one has arrived. -->
    <string name="gate_tally">%1$s / %2$s categories · %3$s</string>
    <!-- The same line for an importer with no addressable categories: an M3U
         playlist is one file, so what rises honestly is the row count.
         %1$s rows committed so far, %2$s received. -->
    <string name="gate_items">%1$s items · %2$s</string>
    <!-- Before the provider's first reply there is no denominator to print. -->
    <string name="gate_starting">Contacting your provider…</string>
    <string name="gate_mac">MAC address</string>
    <string name="gate_provider">Provider</string>


    <!-- ============================================ the dashboard's own two cards

         Castivio's licence, not the provider's subscription. The provider's status
         and expiry are returned by the validator and have nowhere to be stored, so
         they are not shown at all rather than shown from nothing. -->
    <string name="home_status_account">Account status</string>
    <string name="home_status_expires">Expires on</string>
    <!-- Used only where the provider gave no word of its own. Its own word is
         preferred, untranslated, because that is what the user sees on their
         provider's panel and ours disagreeing with theirs helps nobody. -->
    <string name="home_account_active">Active</string>
    <string name="home_account_inactive">Inactive</string>
    <!-- Never asked, which is not the same as refused. -->
    <string name="home_account_unknown">Not checked</string>
    <!-- The provider stated no expiry, or was never asked for one. -->
    <string name="home_expires_none">—</string>

    <!-- The theme control in the header. Two sentences rather than one, because a
         screen reader should announce what the press will do, and that is a
         different sentence on each ground. Copy lives with the screen: a shared
         component may not own it. -->
    <string name="home_theme_lighter">Switch to the lighter theme</string>
    <string name="home_theme_darker">Switch to the darker theme</string>

    <!-- The action row under the section cards. -->
    <!-- Asks the provider again what it says. It downloads no catalogue — sections
         are still fetched by the section that was opened. -->
    <string name="home_refresh">Refresh</string>
    <!-- The row wants a short label; the empty state, which has the width for a
         sentence, keeps `home_change_source`. -->
    <string name="home_change">Change subscription</string>
    <!-- The header chip, worded as the other screens word theirs. -->
    <string name="home_language">Language</string>
    <!-- Catch-up. There is no engine for it in this build, and pressing it says so. -->
    <string name="home_time_shift">Time Shift</string>
    <string name="home_about">About</string>
    <!-- Leaves Castivio. The confirmation belongs to the application, not to Home. -->
    <string name="home_exit">Exit</string>

    <!-- What this device is. %1$s is the address a MAC-activating provider asks for. -->
    <string name="home_device_mac">MAC: %1$s</string>
    <string name="home_device_state">Device: %1$s</string>
    <string name="home_device_activated">Activated</string>
    <string name="home_device_locked">Locked</string>

    <!-- A tile whose section has never been brought onto this device. -->
    <string name="home_not_fetched">Not downloaded yet</string>
    <!-- %1$s is a date and time. Shown under the count on a downloaded section. -->
    <string name="home_fetched_at">On this device · %1$s</string>

    <!-- ============================================================ Channels
         The Live TV board, drawn from the approved Channels reference. -->

    <!-- The breadcrumb: "LIVE TV / ALL CHANNELS". The separator is its own string
         because it is punctuation between two translated words, and a language that
         writes it differently must be able to say so. -->
    <string name="channels_crumb_separator">/</string>
    <!-- Also the rail's first entry, which is a category like any other. The
         reference draws the breadcrumb uppercase; English carries that here rather
         than code uppercasing it, because the same slot also holds a provider's own
         category names and not every language has case at all. -->
    <!-- The same list, named as the rail names it. -->
    <string name="channels_all_rail">All Channels</string>
    <string name="channels_favorites">Favorites</string>
    <string name="channels_recent">Recently Watched</string>

    <string name="channels_search_hint">Search channels</string>
    <!-- The rail's own field, which filters the categories in that column and nothing
         else. Worded to keep the two fields apart: one finds a channel, this one finds
         the bouquet a channel is in. -->
    <string name="channels_rail_search">Search categories</string>
    <!-- The provider\'s own order, which for live television *is* the channel
         numbering — so on this board it is named by what a viewer sees, not by
         where it came from. -->
    <string name="channels_sort_number">Number</string>
    <!-- %1$s is a formatted count. -->
    <!-- The second line of a category in the rail. %1$s is a formatted count, read
         from the group\'s stored item_count rather than counted per row. Deliberately
         shorter than channels_total: it sits under a name in a narrow column. -->
    <string name="channels_rail_total">Total: %1$s</string>
    <!-- Said in the rail when the catalogue holds channels but no categories. Two
         causes reach it and the screen cannot tell them apart: a playlist that
         carries no group-title at all, and a catalogue that has lost its groups. A
         forced re-import settles both, so the line is pressable. -->
    <string name="channels_rail_empty">This playlist lists no categories.</string>

    <!-- On the preview plate, over the channel currently under the remote. -->
    <!-- The guide has nothing for this channel: no guide id, no import, or the
         programme has ended. All three are honestly this sentence. -->
    <string name="channels_no_information">No Information</string>
    <!-- Before any row has been focused, and where a row is not a channel. -->
    <string name="channels_preview_none">No channel selected</string>

    <string name="channels_empty_title">No channels here</string>
    <string name="channels_empty_detail">This category has nothing in it yet. Try another, or download the section again.</string>
    <string name="channels_fetch_failed">Live TV could not be downloaded</string>

    <!-- Said over a board that already has channels on it, so it is a line rather
         than a wall: the catalogue behind it is usable. %1$s is a running count. -->
    <string name="channels_notice_failed">Your provider did not answer. Showing the channels already on this device.</string>

    <!-- The remote legend along the foot of the board. These name what the *remote\'s*
         keys do; only Back is pressable, because a thumb has no key for it. -->
    <!-- The action strip at the leading edge. -->
    <!-- The header's two dates. They are two different things and the captions have
         to keep them apart: one is the provider's subscription, the other is
         Castivio's own licence, and a viewer whose picture has gone needs to know
         which of the two ran out. -->
    <!-- One string each, caption and value together. Two composables side by side
         pin their physical order, and in Arabic that put the date before its own
         caption; a single string lets the text engine place them and it places them
         correctly in both directions. %1$s is a dd-MM-yy token. -->
    <string name="channels_server_expires">Subscription ends: %1$s</string>
    <string name="channels_app_expires">Licence ends: %1$s</string>
    <string name="channels_licence_expired">Expired</string>
    <string name="channels_licence_lifetime">Lifetime</string>
    <!-- On the floating card, under what is on now: the press that opens the whole
         day for the channel that is playing. A word rather than an arrow — "there is
         more here" is a sentence, and an arrow alone reads as decoration. -->
    <!-- The two lines beside the floating card's picture. Short because the panel that
         holds them is a summary four rows tall; the words are the guide's own. -->
    <string name="channels_guide_now">NOW</string>
    <string name="channels_guide_next">NEXT</string>
    <string name="channels_guide_open">Full guide</string>
    <!-- In the guide overlay's header. Back closes it too; this says so for a thumb. -->
    <string name="channels_guide_close">Close</string>
    <string name="channels_action_refresh">Refresh</string>

    <!-- The control on the picture itself. It puts the third column away and gives the
         board back to the channel list; it does not stop the stream, and the next channel
         press brings the column back. Spoken by a screen reader, so it says what it does
         rather than naming the glyph. -->
    <string name="channels_player_close">Close the player</string>

    <!-- The strip under the well: things done to the channel in the picture above it.
         A word under each mark, because five unlabelled icons in a row is a puzzle on a
         television, where there is no hover to explain one. Kept to one short word each:
         the buttons are square and the column is narrow. -->
    <string name="channels_action_guide">Guide</string>
    <string name="channels_action_favorite">Favourite</string>
    <!-- The same button once the channel is in the list: it says what the press will undo. -->
    <string name="channels_action_unfavorite">Favourited</string>
    <string name="channels_action_lock">Lock</string>
    <string name="channels_action_hide">Hide</string>
    <!-- On the display over the picture. Uppercase in English because the reference
         draws it so; a language without case renders its own word. -->
    <string name="channels_live_badge">LIVE</string>


</resources>
