<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Добавете абонамента си</string>
    <string name="trial_name">Пробен период на Castivio</string>
    <string name="mac_label">MAC АДРЕС</string>
    <string name="key_label">КЛЮЧ НА УСТРОЙСТВОТО</string>
    <string name="copy_mac">Копиране на MAC адреса</string>
    <string name="copy_key">Копиране на ключа на устройството</string>
    <string name="copied_mac">MAC адресът е копиран</string>
    <string name="copied_key">Ключът на устройството е копиран</string>
    <string name="add_playlist">Добавяне на плейлист</string>
    <string name="refresh">Обновяване</string>
    <string name="refresh_checking">Проверява се…</string>
    <string name="refresh_found">Намерен е абонамент</string>
    <string name="refresh_none">Вече можете да добавите първия си плейлист.</string>
    <string name="refresh_error">Обновяването не бе успешно — опитайте отново</string>
    <string name="qr_caption">Сканирайте QR кода, за да отворите страницата за активиране на устройството</string>
    <string name="legal_player_only">Castivio е само плейър и не предоставя абонаменти или съдържание.</string>
    <string name="mac_spoken">MAC адрес %s</string>
