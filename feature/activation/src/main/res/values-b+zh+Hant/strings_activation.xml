<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">新增您的訂閱</string>
    <string name="trial_name">Castivio 試用</string>
    <string name="mac_label">MAC 位址</string>
    <string name="key_label">裝置金鑰</string>
    <string name="copy_mac">複製 MAC 位址</string>
    <string name="copy_key">複製裝置金鑰</string>
    <string name="copied_mac">已複製 MAC 位址</string>
    <string name="copied_key">已複製裝置金鑰</string>
    <string name="add_playlist">新增播放清單</string>
    <string name="refresh">重新整理</string>
    <string name="refresh_checking">正在檢查…</string>
    <string name="refresh_found">已找到訂閱</string>
    <string name="refresh_none">尚無訂閱</string>
    <string name="refresh_error">無法重新整理 — 請再試一次</string>
    <string name="qr_caption">掃描以在手機上設定</string>
    <string name="legal_player_only">Castivio 僅為播放器，不提供訂閱或內容。</string>
    <string name="mac_spoken">MAC 位址 %s</string>
