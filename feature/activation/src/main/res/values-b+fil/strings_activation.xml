<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in all 39 locale directories; check-invariants.sh fails
  the build if one does not. "subscription" belongs to the provider -- Castivio's
  seven days are a trial and always carry Castivio's name.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale-sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Idagdag ang iyong subscription</string>
    <string name="trial_name">Pagsubok ng Castivio</string>
    <string name="mac_label">MAC ADDRESS</string>
    <string name="key_label">DEVICE KEY</string>
    <string name="copy_mac">Kopyahin ang MAC address</string>
    <string name="copy_key">Kopyahin ang device key</string>
    <string name="copied_mac">Nakopya ang MAC address</string>
    <string name="copied_key">Nakopya ang device key</string>
    <string name="add_playlist">Magdagdag ng playlist</string>
    <string name="refresh">I-refresh</string>
    <string name="refresh_checking">Sinusuri…</string>
    <string name="refresh_found">May nakitang subscription</string>
    <string name="refresh_none">Wala pang subscription</string>
    <string name="refresh_error">Hindi na-refresh — subukan ulit</string>
    <string name="qr_caption">I-scan para i-set up sa iyong telepono</string>
    <string name="legal_player_only">Ang Castivio ay player lamang at hindi nagbibigay ng subscription o nilalaman.</string>
    <string name="mac_spoken">MAC address %s</string>
    <string name="language">Wika</string>
    <string name="language_count">%d ang available</string>
    <string name="language_close">Isara</string>
    <string name="language_back_hint">Bumalik para isara</string>
    <string name="language_selected">Napili</string>
    <string name="activation_screen">Idagdag ang iyong subscription</string>

    <plurals name="trial_days">
        <item quantity="one">%d araw</item>
        <item quantity="other">%d na araw</item>
    </plurals>

    <string name="locale_sentinel" translatable="false">fil</string>
</resources>
