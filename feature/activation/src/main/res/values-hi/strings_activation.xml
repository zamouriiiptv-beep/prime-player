<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">अपनी सदस्यता जोड़ें</string>
    <string name="trial_name">Castivio परीक्षण</string>
    <string name="mac_label">MAC पता</string>
    <string name="key_label">डिवाइस कुंजी</string>
    <string name="copy_mac">MAC पता कॉपी करें</string>
    <string name="copy_key">डिवाइस कुंजी कॉपी करें</string>
    <string name="copied_mac">MAC पता कॉपी हो गया</string>
    <string name="copied_key">डिवाइस कुंजी कॉपी हो गई</string>
    <string name="add_playlist">प्लेलिस्ट जोड़ें</string>
    <string name="refresh">ताज़ा करें</string>
    <string name="refresh_checking">जाँच हो रही है…</string>
