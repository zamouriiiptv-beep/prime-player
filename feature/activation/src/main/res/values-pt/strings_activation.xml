<?xml version="1.0" encoding="utf-8"?>
<!--
  The activation screen and the language picker.

  Every key here exists in every locale directory; check-invariants.sh fails the
  build if one does not.

  "subscription" belongs to the provider. Castivio's seven days are a trial and
  always carry Castivio's name; a wording that lets the two be read as one is a
  defect, not a nuance.

  The overline labels are stored in the case they are displayed in. Nothing calls
  uppercase() on them: that is locale sensitive, strips accents in Greek and
  produces the wrong I in Turkish.
-->
<resources>
    <string name="activation_title">Adicione sua assinatura</string>
    <string name="trial_name">Teste do Castivio</string>
    <string name="mac_label">ENDEREÇO MAC</string>
    <string name="key_label">CHAVE DO DISPOSITIVO</string>
    <string name="copy_mac">Copiar o endereço MAC</string>
    <string name="copy_key">Copiar a chave do dispositivo</string>
    <string name="copied_mac">Endereço MAC copiado</string>
    <string name="copied_key">Chave do dispositivo copiada</string>
    <string name="add_playlist">Adicionar playlist</string>
    <string name="refresh">Atualizar</string>
    <string name="refresh_checking">Verificando…</string>
    <string name="refresh_found">Assinatura encontrada</string>
    <string name="refresh_none">Agora você pode adicionar sua primeira playlist.</string>
    <string name="refresh_error">Não foi possível atualizar — tente de novo</string>
    <string name="qr_caption">Leia o código QR para abrir a página de ativação do dispositivo</string>
    <string name="legal_player_only">O Castivio é apenas um reprodutor e não fornece assinaturas nem conteúdo.</string>
    <string name="mac_spoken">Endereço MAC %s</string>
    <string name="language">Idioma</string>
    <string name="language_count">%d disponíveis</string>
    <string name="language_close">Fechar</string>
    <string name="language_back_hint">Voltar para fechar</string>
    <string name="language_selected">Selecionado</string>
    <string name="activation_screen">Adicione sua assinatura</string>

    <plurals name="trial_days">
        <item quantity="one">%d dia</item>
        <item quantity="other">%d dias</item>
    </plurals>

    <string name="locale_sentinel" translatable="false">pt-BR</string>
</resources>
